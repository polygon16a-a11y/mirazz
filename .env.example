# Local Docker defaults. A blank PEER_HOST uses the public PeerJS signaling service.
# For production, set NODE_ENV=production, PEER_HOST to your PeerServer hostname,
# and TRUST_PROXY=true only behind a trusted HTTPS reverse proxy.
NODE_ENV=development
APP_PORT=3000
BTC_NETWORK=testnet
PEER_HOST=
PEER_PORT=443
PEER_PATH=/peerjs
PEER_SECURE=true
TRUST_PROXY=false
